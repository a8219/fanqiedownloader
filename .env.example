# HTTP bind address for the Rust server
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,tower_http=info
REQUEST_TIMEOUT_SECS=45

# Recommended: point the Rust compatibility gateway at the deployed Worker.
# This preserves the existing Worker implementation for request signatures,
# encrypted chapter decoding, Durable Objects, KV state, and Telegram handling.
WORKER_UPSTREAM_URL=https://fanqie-downloader.3942369144a.workers.dev

# Optional, user-provided authenticated web session. Do not commit a real value.
# FANQIE_COOKIE=

# Optional Worker-only secrets are configured in Cloudflare, not here:
# TG_BOT_TOKEN=
# FANQIE_ADMIN_USERNAME=
# FANQIE_ADMIN_PASSWORD=