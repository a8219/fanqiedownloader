# HTTP bind address
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info,tower_http=info
REQUEST_TIMEOUT_SECS=45

# Optional: authenticated web session for enhanced access
# FANQIE_COOKIE=

# Optional: upstream proxy API for search fallback
# FANQIE_PROXY_API=

# Telegram Bot (optional)
# TG_BOT_TOKEN=
# FANQIE_ADMIN_USERNAME=
# FANQIE_ADMIN_PASSWORD=

# Online reading page (default: enabled)
FANQIE_ONLINE_READ=1
